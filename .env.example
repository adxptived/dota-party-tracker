# Токен бота от @BotFather
BOT_TOKEN=123456:your-token-here

# --- OpenDota ---------------------------------------------------------------
# Ключ необязателен. Без него лимит — около 2000 запросов в сутки на IP: этого хватает
# примерно на 6–8 игроков суммарно по всем чатам. С ключом суточного потолка нет.
# OPENDOTA_API_KEY=
# OPENDOTA_MIN_INTERVAL=1.1   # пауза между запросами, сек (с ключом по умолчанию 0.25)
# OPENDOTA_BURST=5            # сколько запросов можно отправить подряд без паузы (1 — строго по одному)
# OPENDOTA_ENRICH_DAYS=90     # за сколько последних дней догружать детали матчей (перф, нетворт); 0 — за всю историю
# OPENDOTA_DAILY_RESERVE=800  # без ключа: когда до конца суточного лимита остаётся меньше, фоновая догрузка ждёт
# OPENDOTA_PROXY=            # прокси только для OpenDota: socks5h://хост:порт или http://хост:порт (бывают user:pass@). Если api.opendota.com недоступен из вашей сети
# INLINE_CACHE_CHAT=          # ID чата, куда бот заливает картинки для inline-режима (@бот Вася). Пусто — inline отвечает текстом. Бот должен быть в этом чате
# COMMAND_REFRESH_WAIT=4      # сколько секунд команда ждёт обновление игроков; дольше — ответ из БД, обновление доходит фоном (0 — не ждать)

# --- Доступ -----------------------------------------------------------------
# ID чатов через запятую, где бот работает. Пусто — отвечает всем, кто его найдёт
# (и чужие чаты тратят ваш лимит OpenDota). ID группы показывает, например, @userinfobot.
# ALLOWED_CHATS=-1001234567890,123456789
# MAX_PLAYERS=16              # игроков на один чат

# --- Значения для новых чатов (дальше меняются в /settings) -------------------
# DEFAULT_DIGEST_HOUR=10
# DEFAULT_TZ=Europe/Moscow
# DEFAULT_MMR_STEP=25

# --- Прочее -----------------------------------------------------------------
# DB_PATH=mmrbot.db
# BACKUP_KEEP=7               # сколько суточных копий БД хранить в <папка БД>/backups (0 — выключить)
# STRATZ_API_KEY=             # позиция/роль/IMP по матчам; без него работает на OpenDota
# STEAM_API_KEY=              # экспериментально: оповещения «зашёл в Dota 2»; без ключа выключены

# --- Ошибки -----------------------------------------------------------------
# ERROR_CHAT_ID=              # ваш Telegram ID (или ID чата): сюда бот шлёт свои ошибки. Сначала напишите боту /start
# SENTRY_DSN=                 # то же в Sentry; нужен пакет: pip install sentry-sdk
